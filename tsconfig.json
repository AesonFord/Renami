{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/core",
    "src/main",
    "src/preload",
    "src/shared",
    "test/core",
    "test/main",
    "e2e",
    "vitest.config.ts",
    "electron.vite.config.ts",
    "playwright.config.ts"
  ]
}
