{
  "name": "renami",
  "productName": "Renami",
  "description": "Rename files in bulk from a pattern",
  "version": "0.1.0",
  "author": "Renami",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "out/main/index.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "electron-vite build && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "fixtures": "node scripts/make-fixtures.mjs",
    "pack": "electron-vite build && electron-builder --dir --publish never",
    "dist": "electron-vite build && electron-builder --config electron-builder.release.yml --publish never"
  },
  "dependencies": {
    "exiftool-vendored": "^38.1.0",
    "heic-decode": "^2.1.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-virtual": "^3.14.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.1",
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "jsdom": "^30.1.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "4.63.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
